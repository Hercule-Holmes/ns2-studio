{
  "name": "@ns2-studio/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "NS2 Studio desktop app (electron-vite + Vue3 + TypeScript)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "pnpm --filter @ns2-studio/remote-client run build && electron-vite dev",
    "build": "pnpm --filter @ns2-studio/remote-client run build && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && vue-tsc --noEmit --composite false -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "pnpm --filter @ns2-studio/remote-client run build && electron-vite build && electron-builder --win",
    "pack": "pnpm --filter @ns2-studio/remote-client run build && electron-vite build && electron-builder --dir"
  },
  "author": "NS2 Studio contributors",
  "dependencies": {
    "@ns2-studio/pad-types": "workspace:*",
    "@ns2-studio/protocol": "workspace:*",
    "@ns2-studio/timeline-model": "workspace:*",
    "lucide-vue-next": "^1.0.0",
    "node-hid": "^3.4.0",
    "serialport": "^12.0.0",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "qrcode": "^1.5.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.11"
  },
  "build": {
    "appId": "com.ns2studio.desktop",
    "productName": "NS2 Studio",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "NS2Studio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "NS2Studio-Portable-${version}.${ext}"
    }
  }
}